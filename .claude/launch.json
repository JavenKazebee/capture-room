{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "ui",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "ui-node2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "ui",
        "dev"
      ],
      "env": {
        "CAPTURE_ROOM_NODE": "localhost:7701"
      },
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "node",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "capture-room",
        "--",
        "--controller",
        "--db",
        "dev-node.db"
      ],
      "port": 7700
    },
    {
      "name": "node2",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "capture-room",
        "--",
        "--port",
        "7701",
        "--db",
        "dev-node2.db"
      ],
      "port": 7701
    }
  ]
}
